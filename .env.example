# OpenBot environment template — copy to `.env` and fill in.
# PRD §7 部署：30 分钟 setup.sh wizard 会把 GitHub App 创建后的值写进来。
# 真正的 .env 永远不要 commit（.gitignore + pre-commit block-secret-files.sh 双保险）。
#
# ─────── 推荐工作流：Doppler ───────
# 维护者本机 / staging / prod 默认走 Doppler，.env 仅作离线/CI fallback。
#   一次性 bootstrap:
#     ./scripts/doppler-bootstrap-shared.sh          # 从 infra/prd 同步共享 LLM token
#     doppler setup --project openbot --config dev   # 绑定本仓库到 dev config
#   日常启动:
#     doppler run -- uvicorn openbot.main:app --reload
#   切换环境:
#     doppler run --config stg -- python -m openbot.worker
#   本地导出成 .env（仅当无法跑 doppler 时）:
#     doppler secrets download --no-file --format env > .env

# ─────── GitHub App (PRD §13 #5: 每用户自建) ───────
# OPENBOT_GITHUB_APP_ID=
# OPENBOT_GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-private.pem
# OPENBOT_GITHUB_WEBHOOK_SECRET=

# ─────── LLM API key (PRD §13 #2 默认路由) ───────
# ANTHROPIC_API_KEY=               # review/fix → claude-opus-4-7
#                                  # triage/chat → claude-sonnet-4-6
# OPENAI_API_KEY=                  # fallback model

# ─────── Sandbox (PRD §13 #14: Modal) ───────
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# ─────── Observability (eval PRD §13.2: dual-project routing) ───────
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT_INTERNAL=openbot-eval-internal   # raw trace + internal sample
# LANGSMITH_PROJECT_PUBLIC=openbot-eval-public       # aggregate only, no raw internal data
# LANGSMITH_PROJECT=openbot-prod                     # main app (non-eval) — legacy single-project key

# ─────── Cost / kill switches (PRD §4.5 / §4.7) ───────
# OPENBOT_GLOBAL_HARD_KILL_USD=500   # 覆盖 config.yaml budget.global_hard_kill_usd
# OPENBOT_KILL_SWITCH=false          # 紧急停机开关；true → 所有 worker 立即停 dequeue

# ─────── Storage (PRD §13 #3) ───────
# POSTGRES_URL=postgresql://openbot:openbot@localhost:5432/openbot
# REDIS_URL=redis://localhost:6379/0
# R2_ACCESS_KEY_ID=                  # 可选，未配则 fallback 到 local FS
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=openbot-artifacts

# ─────── App ───────
# OPENBOT_DEBUG=false
