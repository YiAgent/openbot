[importlinter]
root_package = openbot

[importlinter:contract:layers]
name = Hexagonal layers — domain ← application ← infrastructure ← entrypoints
type = layers
layers =
    openbot.entrypoints
    openbot.application : openbot.infrastructure
    openbot.domain
    openbot.core
unmatched_ignore_imports_alerting = warn
ignore_imports =
    # Documented exceptions — each must have a justification comment:

    # AuditLogRepo: concrete fallback when AuditLogPort not injected (composition root exception)
    openbot.application.middleware.audit -> openbot.infrastructure.persistence.repository
    openbot.application.middleware.preflight -> openbot.infrastructure.persistence.repository
    openbot.application.use_cases._lifecycle -> openbot.infrastructure.persistence.repository
    openbot.application.use_cases.debug_echo -> openbot.infrastructure.persistence.repository

    # CostMeterRepo: concrete fallback for budget enforcement
    openbot.application.middleware.budget -> openbot.infrastructure.persistence.repository

    # TaskRun ORM model: application.state is the anti-corruption layer for the state machine
    openbot.application.state.runs_repo -> openbot.infrastructure.persistence.models

    # config_loader: dispatcher uses infra load_for_repo directly (port injection pending)
    openbot.application.dispatcher -> openbot.infrastructure.config_loader

[importlinter:contract:no-testing-in-runtime]
name = Production code must not import openbot.testing
type = forbidden
source_modules =
    openbot.domain
    openbot.application
    openbot.infrastructure
    openbot.entrypoints
    openbot.core
    openbot.dispatcher
    openbot.evaluation
forbidden_modules =
    openbot.testing
